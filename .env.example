# Copy to .env locally and replace the socket path after starting devenv.
# Never commit .env or passwords. The seed prompts for credentials without echo.
IHP_ENV=Development
DATABASE_URL=postgresql:///sga_demo?host=/PATH/TO/LOCAL/POSTGRES_SOCKET

# Optional confidential notes: provision secrets locally, never commit values.
# SGA_FIELD_ENCRYPTION_ACTIVE_KEY_ID: identifier (ASCII letters/digits/_/-, 1-64).
# SGA_FIELD_ENCRYPTION_KEYS: JSON object mapping identifiers to Base64-encoded
# 32-byte random keys; keep old IDs for reading, choose active ID for writing.
# No fallback to the IHP session key or the demonstration-only single-key loader.
